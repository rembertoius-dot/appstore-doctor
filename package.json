{
  "name": "appstore-doctor",
  "version": "0.1.0",
  "description": "Pre-submission checks for iOS apps. Ship your AI-built iOS app with confidence.",
  "license": "MIT",
  "type": "module",
  "bin": { "appstore-doctor": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/guidelines && cp src/guidelines/index.json dist/guidelines/",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "guidelines": "tsx scripts/build-guidelines-index.ts",
    "coverage-map": "tsx scripts/build-coverage.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fast-plist": "^0.1.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
